<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs on plain .NET with no game files: Core has no Unity or game references, by design. dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\src\SPSave\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
