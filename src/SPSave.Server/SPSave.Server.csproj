<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SPSave's server mod: the profile lock while a saved raid waits (docs/C3-PLAN.md).
    dotnet build src\SPSave.Server -c Release -p:SPTPath="H:\SPT4.1.X" [-p:DeployToSPT=true]
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SPSave.Server</AssemblyName>
    <RootNamespace>SPSave.Server</RootNamespace>
    <Version>0.9.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SPTPath Condition="'$(SPTPath)' == ''">H:\SPT4.1.X</SPTPath>
    <SPTRuntime>$(SPTPath)\SPT_Runtime</SPTRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SPTRuntime)\SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(SPTRuntime)\SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Reflection"><HintPath>$(SPTRuntime)\SPTarkov.Reflection.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(SPTRuntime)\SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(SPTRuntime)\SemanticVersioning.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SPTRuntime)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="DeployToSPT" AfterTargets="Build" Condition="'$(DeployToSPT)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SPTRuntime)\user\mods\SPSave" />
  </Target>
</Project>
