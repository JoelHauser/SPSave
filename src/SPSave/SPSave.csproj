<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SPSave</AssemblyName>
    <RootNamespace>SPSave</RootNamespace>
    <!-- Keep in step with Plugin.Version. -->
    <Version>0.4.2</Version>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <DeployToSPT Condition="'$(DeployToSPT)' == ''">false</DeployToSPT>
  </PropertyGroup>

  <!--
    dotnet build src\SPSave -c Release -p:SPTPath="H:\SPT4.1.X"
    Add -p:DeployToSPT=true to copy the DLL into BepInEx\plugins; -t:PackageRelease writes the zip to dist\.
  -->
  <PropertyGroup>
    <SPTPath Condition="'$(SPTPath)' == ''">$(SPT_PATH)</SPTPath>
    <SPTPath Condition="'$(SPTPath)' != ''">$(SPTPath.TrimEnd('\'))</SPTPath>
    <SPTManagedPath>$(SPTPath)\EscapeFromTarkov_Data\Managed</SPTManagedPath>
    <SPTBepInExPath>$(SPTPath)\BepInEx</SPTBepInExPath>
  </PropertyGroup>

  <Target Name="ValidateSPTPath" BeforeTargets="BeforeBuild">
    <Error Condition="'$(SPTPath)' == ''" Text="SPTPath is not set. e.g. -p:SPTPath=H:\SPT4.1.X" />
    <Error Condition="!Exists('$(SPTManagedPath)\Assembly-CSharp.dll')" Text="SPTPath ('$(SPTPath)') is not an SPT install root." />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(SPTManagedPath)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Comfort"><HintPath>$(SPTManagedPath)\Comfort.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(SPTManagedPath)\Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <!-- Player implements IDissonancePlayer, so converting a Player to IPlayer needs this. -->
    <Reference Include="DissonanceVoip"><HintPath>$(SPTManagedPath)\DissonanceVoip.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(SPTManagedPath)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(SPTManagedPath)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(SPTManagedPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(SPTManagedPath)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(SPTManagedPath)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(SPTManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(SPTManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(SPTBepInExPath)\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SPTBepInExPath)\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="spt-common"><HintPath>$(SPTBepInExPath)\plugins\spt\spt-common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="spt-reflection"><HintPath>$(SPTBepInExPath)\plugins\spt\spt-reflection.dll</HintPath><Private>false</Private></Reference>
    <!-- SAIN is optional at run time (SainCompat only touches it when loaded) but needed to build: the install must have it. -->
    <Reference Include="SAIN"><HintPath>$(SPTBepInExPath)\plugins\SAIN\SAIN.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SAIN.Preset.Shared"><HintPath>$(SPTBepInExPath)\plugins\SAIN\SAIN.Preset.Shared.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="DeployToSPT" AfterTargets="Build" Condition="'$(DeployToSPT)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SPTBepInExPath)\plugins" />
  </Target>

  <Target Name="PackageRelease" DependsOnTargets="Build">
    <PropertyGroup>
      <StagingDir>$(MSBuildProjectDirectory)\..\..\dist\staging</StagingDir>
      <ZipPath>$(MSBuildProjectDirectory)\..\..\dist\SPSave-$(Version)-SPT4.1.x.zip</ZipPath>
    </PropertyGroup>
    <RemoveDir Directories="$(StagingDir)" />
    <MakeDir Directories="$(StagingDir)\BepInEx\plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StagingDir)\BepInEx\plugins" />
    <Delete Files="$(ZipPath)" />
    <ZipDirectory SourceDirectory="$(StagingDir)" DestinationFile="$(ZipPath)" />
    <RemoveDir Directories="$(StagingDir)" />
    <Message Importance="high" Text="Release archive: $(ZipPath)" />
  </Target>

</Project>
